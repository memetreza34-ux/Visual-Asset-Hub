{
  "name": "visual-asset-hub",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "asset:add": "node scripts/add-asset.mjs",
    "media:analyze": "node scripts/analyze-media.mjs",
    "inbox:scan": "node scripts/scan-inbox.mjs",
    "inbox:review": "node scripts/review-inbox.mjs",
    "source:search": "node scripts/source-search.mjs",
    "source:grab": "node scripts/source-grab.mjs",
    "pexels:search": "node scripts/pexels-search.mjs",
    "pexels:grab": "node scripts/pexels-grab.mjs",
    "validate": "node scripts/validate-catalog.mjs",
    "index": "node scripts/build-index.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate && npm run index && npm run test"
  }
}
