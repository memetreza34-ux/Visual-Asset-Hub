{
  "name": "visual-asset-hub",
  "version": "0.4.0-beta.2",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "cleanup:local": "node scripts/cleanup-local-searches.mjs",
    "starter:import": "node scripts/tag-existing-channel-assets.mjs && node scripts/import-channel-starter-pack.mjs",
    "asset:add": "node scripts/add-asset.mjs",
    "asset:review": "node scripts/review-asset.mjs",
    "usage:add": "node scripts/record-usage.mjs",
    "attribution:export": "node scripts/export-attribution.mjs",
    "media:pack": "node scripts/export-media-pack.mjs",
    "backup": "node scripts/catalog-backup.mjs",
    "restore": "node scripts/catalog-restore.mjs",
    "beta:verify": "node scripts/beta-verify.mjs",
    "links:check": "node scripts/check-external-links.mjs",
    "pexels:search": "node scripts/pexels-search.mjs",
    "pexels:gallery": "node scripts/pexels-gallery.mjs",
    "pexels:import": "node scripts/pexels-batch-import.mjs",
    "pexels:select": "node scripts/pexels-import-selected.mjs",
    "arsenal:validate": "node scripts/validate-channel-library.mjs",
    "arsenal:plan": "node scripts/build-arsenal-plan.mjs",
    "arsenal:search": "node scripts/pexels-arsenal-search.mjs",
    "arsenal:import": "node scripts/arsenal-import-selected.mjs",
    "arsenal:report": "node scripts/channel-coverage-report.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "validate": "node scripts/validate-catalog.mjs && node scripts/validate-channel-library.mjs && node scripts/validate-preview-urls.mjs && node scripts/validate-operations.mjs",
    "index": "node scripts/build-index.mjs",
    "report": "node scripts/catalog-report.mjs",
    "site:build": "node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test",
    "syntax": "node scripts/check-syntax.mjs",
    "check": "npm run secrets:scan && npm run syntax && npm run validate && npm run index && npm run test"
  }
}
