# Lokal nach .env kopieren. Niemals echte Schlüssel committen.
# Der Browser-Arsenal-Builder speichert Schlüssel nicht; dort werden sie nur für die aktuelle Suche eingegeben.
PEXELS_API_KEY=
PIXABAY_API=
UNSPLASH_ACCESS_KEY=

# Optional für automatische Phase-3-Wort-Timestamps aus 02-AUDIO/voiceover.mp3.
# Bleibt lokal als Umgebungsvariable und wird nicht in Doku-Projektdateien geschrieben.
OPENAI_API_KEY=

# GitHub Repository-Secrets im aktuellen Projekt:
# PEXELS_API
# PIXABAY_API
# UNSPLASH_API

# Optionaler externer Speicher:
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
