# Lokal nach .env kopieren. Niemals echte Schlüssel committen.
# Der Browser-Arsenal-Builder speichert Schlüssel nicht; dort werden sie nur für die aktuelle Suche eingegeben.
PEXELS_API_KEY=
PIXABAY_API=
UNSPLASH_ACCESS_KEY=

# Autonome Doku-Phase 1: Themenwahl + Web-Recherche + ca. 2,5-Minuten-Skript.
# Phase 3 nutzt denselben Key optional fuer automatische Wort-Timestamps.
# Der Visual Director nutzt ihn ausserdem fuer den optionalen Vision-Gate auf echten Preview-Bildern.
OPENAI_API_KEY=
# Optional. Standard fuer autonome Phase 1 ist gpt-5.5.
OPENAI_PHASE1_MODEL=gpt-5.5
# Optional. Wenn leer/nicht gesetzt, verwendet der Vision-Gate die Phase-1-Modellkonfiguration.
OPENAI_VISION_MODEL=

# NASA Image and Video Library und Library of Congress benoetigen in der aktuellen Integration keinen lokalen API-Key.

# GitHub Repository-Secrets im aktuellen Projekt:
# PEXELS_API
# PIXABAY_API
# UNSPLASH_API

# Optionaler externer Speicher:
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
