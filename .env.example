# Lokal nach .env kopieren. Niemals echte Schlüssel committen.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: eigene kostenlose SearXNG-Instanz für breite Web-Recherche.
# JSON muss in SearXNG aktiviert sein.
# Beispiel: http://127.0.0.1:8080
SEARXNG_URL=

# Optional für höhere Openverse-Limits, aktuell nicht erforderlich:
# OPENVERSE_CLIENT_ID=
# OPENVERSE_CLIENT_SECRET=

# Später optional:
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
